# =====================================================
# Plantilla de configuración del BACKEND - HYR
# Copia este archivo a .env y completa los valores reales.
#   cp .env.example .env
# .env está en .gitignore: NUNCA se commitea.
# =====================================================

# Entorno: development | production
NODE_ENV=development

# Puerto y host del API Express
PORT=3001
HOST=0.0.0.0

# --- PostgreSQL ---
# En desarrollo local suele ser localhost / postgres.
# En producción: usuario dedicado con permisos sobre la base hyr_construction.
DB_HOST=localhost
DB_NAME=hyr_construction
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# --- Opcionales (tienen defaults sensatos en database/connection.js) ---
# DB_TIMEOUT=5000
# DB_IDLE_TIMEOUT=30000
# DB_MAX_CONNECTIONS=20
